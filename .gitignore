# ── System ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors / IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment / secrets ────────────────────────────────────────────────
# Hub auth tokens live in ~/.config/claude-buddy/token (outside the repo),
# but block any accidental stray drops of dotenv-style files too.
.env
.env.*
!.env.example
*.pem

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Python (server/python/) ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.uv-cache/
# uv.lock is committed — do not ignore.

# ── Node / Next.js (web/) ────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
build/
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Auto-generated by Next.js on dev start; re-created each run
next-env.d.ts

# Yarn PnP — only listed to pin the exception set; this repo uses Bun
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# package-lock.json / bun.lock are committed — do not ignore.

# ── Test output ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Deployment ───────────────────────────────────────────────────────────
.vercel/
